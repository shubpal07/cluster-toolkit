apiVersion: kueue.x-k8s.io/v1beta1
kind: ResourceFlavor
metadata:
  name: tpu-v6e-8x8
spec:
  nodeLabels:
    cloud.google.com/gke-tpu-accelerator: tpu-v6e
    cloud.google.com/gke-tpu-topology: 8x8
---
apiVersion: kueue.x-k8s.io/v1beta1
kind: ResourceFlavor
metadata:
  name: tpu-v6e-8x16
spec:
  nodeLabels:
    cloud.google.com/gke-tpu-accelerator: tpu-v6e
    cloud.google.com/gke-tpu-topology: 8x16
---
apiVersion: kueue.x-k8s.io/v1beta1
kind: ResourceFlavor
metadata:
  name: tpu-v6e-16x16
spec:
  nodeLabels:
    cloud.google.com/gke-tpu-accelerator: tpu-v6e
    cloud.google.com/gke-tpu-topology: 16x16
---
apiVersion: kueue.x-k8s.io/v1beta1
kind: ClusterQueue
metadata:
  name: cluster-queue
spec:
  preemption:
    reclaimWithinCohort: Never
    withinClusterQueue: LowerPriority
  namespaceSelector: {}
  resourceGroups:
  - coveredResources: ["google.com/tpu"]
    flavors:
    - name: tpu-v6e-8x8
      resources:
      - name: "google.com/tpu"
        nominalQuota: 256 # 4 slices of 64 chips
    - name: tpu-v6e-8x16
      resources:
      - name: "google.com/tpu"
        nominalQuota: 256 # 2 slices of 128 chips
    - name: tpu-v6e-16x16
      resources:
      - name: "google.com/tpu"
        nominalQuota: 1536 # 6 slices of 256 chips
---
apiVersion: kueue.x-k8s.io/v1beta1
kind: LocalQueue
metadata:
  namespace: default
  name: multislice-queue
spec:
  clusterQueue: cluster-queue
